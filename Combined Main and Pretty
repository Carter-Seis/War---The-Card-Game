# MAIN CODE - Visual improvements added from the Pretty version
# main.py
import matplotlib.pyplot as plt
from shuffle_deck import create_and_save_deck

# Step 1: Create and save the shuffled deck using File I/O
create_and_save_deck()

# PRETTY ADDITION: Welcome screen
print("\n================================")
print("          WELCOME TO WAR!")
print("================================")

# Step 2: Read the deck back from deck.txt using basic File I/O
deck1 = []
deck2 = []

file = open("deck.txt", "r")
lines = file.readlines()
file.close()

# Split lines into deck 1 and deck 2 using a simple loop
index = 0
for line in lines:
    line = line.strip()
    parts = line.split(",")
    card_name = parts[0]
    card_val = int(parts[1])

    card = [card_name, card_val]

    if index < 26:
        deck1.append(card)
    else:
        deck2.append(card)

    index = index + 1

choice = input("\nChoose a deck (1 or 2): ")

if choice == "1":
    your_deck = deck1
    opponent_deck = deck2
else:
    your_deck = deck2
    opponent_deck = deck1

round_num = 1
wins = 0
losses = 0
ties = 0

# PRETTY ADDITION: Limit the game and track cards for the line chart
max_rounds = 50
your_history = [len(your_deck)]
opponent_history = [len(opponent_deck)]

# Game Loop (same basic structure as the main code)
while len(your_deck) > 0 and len(opponent_deck) > 0 and round_num <= max_rounds:
    print("\n---------- ROUND " + str(round_num) + " ----------")

    # Draw top card (first item in the list)
    your_card = your_deck[0]
    opponent_card = opponent_deck[0]

    # Remove top cards from decks
    your_deck.remove(your_card)
    opponent_deck.remove(opponent_card)

    # PRETTY ADDITION: Easier-to-read card display
    print("\nYour Card:     " + your_card[0])
    print("Opponent Card: " + opponent_card[0])

    if your_card[1] > opponent_card[1]:
        print("\nYOU WIN ROUND " + str(round_num) + "!")
        your_deck.append(your_card)
        your_deck.append(opponent_card)
        wins = wins + 1
    elif your_card[1] < opponent_card[1]:
        print("\nYOU LOSE ROUND " + str(round_num) + "!")
        opponent_deck.append(your_card)
        opponent_deck.append(opponent_card)
        losses = losses + 1
    else:
        print("\nIT'S A TIE IN ROUND " + str(round_num) + "!")
        your_deck.append(your_card)
        opponent_deck.append(opponent_card)
        ties = ties + 1

    # PRETTY ADDITION: Record each round's card totals
    your_history.append(len(your_deck))
    opponent_history.append(len(opponent_deck))

    # PRETTY ADDITION: Scoreboard
    print("\n---------- SCORE ----------")
    print("Your round wins: " + str(wins))
    print("Opponent round wins: " + str(losses))
    print("Tied rounds: " + str(ties))
    print("\nYour cards: " + str(len(your_deck)))
    print("Opponent cards: " + str(len(opponent_deck)))
    print("Total cards: " + str(len(your_deck) + len(opponent_deck)))

    # PRETTY ADDITION: Stop automatically after 50 rounds
    if round_num == max_rounds or len(your_deck) == 0 or len(opponent_deck) == 0:
        break

    user_choice = input("\nPress Y to play the next round (or N to stop): ")
    if user_choice.lower() == "no" or user_choice.lower() == "n":
        break

    round_num = round_num + 1

# PRETTY ADDITION: Game over screen and final winner
print("\n================================")
print("           GAME OVER")
print("================================")

if len(your_deck) > len(opponent_deck):
    print("YOU WIN BY HAVING MORE CARDS!")
elif len(your_deck) < len(opponent_deck):
    print("THE OPPONENT WINS BY HAVING MORE CARDS!")
else:
    print("THE GAME ENDED IN A TIE!")

if round_num == max_rounds:
    print("50 ROUND LIMIT REACHED!")

# Game Statistics (original variables preserved)
print("\n---------- FINAL STATISTICS ----------")
print("Total rounds played: " + str(len(your_history) - 1))
print("Wins: " + str(wins))
print("Losses: " + str(losses))
print("Ties: " + str(ties))
print("Your final card count: " + str(len(your_deck)))
print("Opponent final card count: " + str(len(opponent_deck)))

# PRETTY ADDITION: Line chart for card distribution over time
rounds = list(range(len(your_history)))
plt.figure()
plt.plot(rounds, your_history, label="Your Cards")
plt.plot(rounds, opponent_history, label="Opponent Cards")
plt.title("War: Card Distribution Over Time")
plt.xlabel("Round Number")
plt.ylabel("Number of Cards")
plt.legend()
plt.grid(True)
plt.show()

